<% layout('layouts/boilerplate') %>

    <section class="py-5 d-flex align-items-center" style="min-height: 80vh; background-color: var(--manzar-cream);">
        <div class="container-xl px-4 text-center">

            <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto"
                style="max-width: 620px; background: #FFFFFF; border: 1px solid var(--manzar-border) !important;">
                <div class="mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                        style="width: 80px; height: 80px; background: #D4EDDA; color: #155724; font-size: 2.5rem;">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>

                <span class="text-uppercase small fw-bold text-muted" style="letter-spacing: 0.15em;">M N &amp; SONS
                    &middot; BUSINESS DESK</span>
                <h2 class="font-serif fw-bold mt-2" style="color: #174840;">
                    <%= enquiry.type %> Request Received!
                </h2>
                <p class="text-muted mt-2">
                    Thank you, <strong>
                        <%= enquiry.name %>
                    </strong>. Our commercial team in Purnia will review your requirements and call you at <strong>
                        <%= enquiry.phone %>
                    </strong> within 24 hours.
                </p>

                <div class="p-3 rounded-3 text-start mb-4" style="background: #FAF7F2; border: 1px solid #E8DCCF;">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Inquiry Type:</span>
                        <strong style="color: #174840;">
                            <%= enquiry.type %>
                        </strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Entity / Location:</span>
                        <span>
                            <%= enquiry.organization ? enquiry.organization + ', ' : '' %>
                                <%= enquiry.city %>
                        </span>
                    </div>
                    <% if (enquiry.quantityOrInvestment) { %>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Scale / Requirement:</span>
                            <strong>
                                <%= enquiry.quantityOrInvestment %>
                            </strong>
                        </div>
                        <% } %>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <a href="<%= waLink %>" target="_blank"
                        class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-whatsapp me-1"></i> Connect on WhatsApp Now
                    </a>
                    <a href="/" class="btn btn-outline-dark rounded-pill px-4 py-2">
                        Return to Shop
                    </a>
                </div>

            </div>

        </div>
    </section>