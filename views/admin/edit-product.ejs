<% layout('layouts/boilerplate') %>

<section class="py-5" style="min-height: 85vh; background: #FAF7F2;">
    <div class="container-xl px-4" style="max-width: 900px;">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: #E8DCCF !important;">
            <div>
                <a href="/admin/products" class="text-decoration-none small text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Back to Products
                </a>
                <h1 class="font-serif fw-bold mt-1 mb-0" style="color: #174840;">Edit Product</h1>
                <small class="text-muted"><%= product.title || product.name %></small>
            </div>
            <a href="/admin/products" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                Cancel
            </a>
        </div>

        <!-- Edit Form Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 p-md-5" style="border: 1px solid #E8DCCF !important;">
            <form action="/admin/products/<%= product._id %>/edit" method="POST">
                <div class="row g-4">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold text-muted">PRODUCT TITLE / NAME *</label>
                        <input type="text" name="title" class="form-control rounded-3" value="<%= product.title || product.name %>" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">CATEGORY *</label>
                        <select name="category" class="form-select rounded-3">
                            <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                                <% for (let cat of categories) { %>
                                    <option value="<%= cat.name %>" <%= (product.category === cat.name) ? 'selected' : '' %>>
                                        <%= cat.name %>
                                    </option>
                                <% } %>
                            <% } else { %>
                                <option value="<%= product.category || 'General' %>" selected><%= product.category || 'General' %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">SELLING PRICE (₹) *</label>
                        <input type="number" name="price" class="form-control rounded-3" value="<%= product.price %>" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">MRP / ORIGINAL PRICE (₹)</label>
                        <input type="number" name="discountPrice" class="form-control rounded-3" value="<%= product.discountPrice || '' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">SHEET GAUGE</label>
                        <input type="text" name="sheetThickness" class="form-control rounded-3" value="<%= product.sheetThickness || product.gauge || '18 Gauge (1.2mm)' %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">APPROX WEIGHT (KG)</label>
                        <input type="number" name="weightKg" class="form-control rounded-3" value="<%= product.weightKg || 95 %>">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">COLOR</label>
                        <input type="text" name="color" class="form-control rounded-3" value="<%= product.color || 'Steel Grey' %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">LOCK TYPE</label>
                        <input type="text" name="lockType" class="form-control rounded-3" value="<%= product.lockType || 'Ultra-Secure Lever Lock' %>">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">DIMENSIONS</label>
                        <input type="text" name="dimensions" class="form-control rounded-3" value="<%= product.dimensions || '78\"H x 36\"W x 20\"D' %>">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">IMAGE URL *</label>
                        <input type="url" name="image" class="form-control rounded-3" value="<%= product.image %>" required>
                        <% if (product.image) { %>
                            <div class="mt-2">
                                <img src="<%= product.image %>" alt="Preview" class="rounded-3 shadow-sm" style="height: 90px; width: 90px; object-fit: cover; border: 1px solid #E8DCCF;">
                            </div>
                        <% } %>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">PRODUCT DESCRIPTION</label>
                        <textarea name="description" rows="4" class="form-control rounded-3"><%= product.description || '' %></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" name="isFeatured" id="featEdit" <%= (product.isFeatured || product.featured) ? 'checked' : '' %>>
                            <label class="form-check-label small fw-bold text-dark" for="featEdit">
                                Feature on Homepage Hero Section
                            </label>
                        </div>
                    </div>

                    <div class="col-12 pt-3 border-top d-flex gap-3 justify-content-end">
                        <a href="/admin/products" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-manzar-primary px-5 rounded-pill">
                            <i class="bi bi-check-circle me-1"></i> Update Product
                        </button>
                    </div>
                </div>
            </form>
        </div>

    </div>
</section>
