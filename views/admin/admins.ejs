<% layout('layouts/boilerplate') %>

    <% const mEmail=(typeof masterAdminEmail !=='undefined' ? masterAdminEmail : (typeof masterEmail !=='undefined' ?
        masterEmail : 'admin@mnandsons.com' )).toLowerCase(); const cEmail=(typeof currentAdminEmail !=='undefined' ?
        currentAdminEmail : (typeof currentAdmin !=='undefined' && currentAdmin ? currentAdmin.email :
        mEmail)).toLowerCase(); const isCurrentUserMaster=(cEmail===mEmail); %>

        <section class="py-5" style="min-height: 85vh; background: #FAF7F2;">
            <div class="container-xl px-4">

                <!-- Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom"
                    style="border-color: #E8DCCF !important;">
                    <div>
                        <a href="/admin" class="text-decoration-none small text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                        </a>
                        <h1 class="font-serif fw-bold mt-1 mb-0" style="color: #174840;">
                            <i class="bi bi-shield-lock-fill text-warning me-2"></i>Administrator Access Control
                        </h1>
                        <small class="text-muted">Master Admin: <strong class="text-dark">
                                <%= mEmail %>
                            </strong></small>
                    </div>

                    <!-- Add Admin Button (Only visible to Master Admin) -->
                    <% if (isCurrentUserMaster) { %>
                        <button class="btn btn-manzar-primary btn-sm px-4 rounded-pill mt-3 mt-md-0"
                            data-bs-toggle="modal" data-bs-target="#addAdminModal">
                            <i class="bi bi-person-plus-fill me-1"></i> Add New Sub-Admin
                        </button>
                        <% } %>
                </div>

                <!-- Admins Table Card -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white"
                    style="border: 1px solid #E8DCCF !important;">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-muted text-uppercase" style="letter-spacing: 0.05em;">
                                <tr>
                                    <th class="ps-4 py-3">Administrator</th>
                                    <th class="py-3">Email Address</th>
                                    <th class="py-3">Access Level</th>
                                    <th class="py-3">Date Added</th>
                                    <th class="text-end pe-4 py-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- 👑 ROW 1: MASTER ADMIN (Always at Top) -->
                                <tr style="background-color: #fdfbf7;">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm"
                                                style="width: 42px; height: 42px; background: #174840; font-weight: bold; font-size: 1.1rem;">
                                                👑
                                            </div>
                                            <div>
                                                <strong class="d-block" style="color: #174840; font-size: 0.95rem;">
                                                    Owner / Primary Admin
                                                </strong>
                                                <span class="badge bg-warning text-dark fw-bold"
                                                    style="font-size: 0.7rem;">
                                                    👑 Master Admin
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">
                                            <%= mEmail %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success text-white px-3 py-1 rounded-pill">
                                            Full Master Rights (Root)
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        Permanent System Account
                                    </td>
                                    <td class="text-end pe-4">
                                        <span class="badge bg-light text-muted border px-2 py-1">Permanent Master</span>
                                    </td>
                                </tr>

                                <!-- 👥 SUB-ADMINS (Safe for...of loop) -->
                                <% if (typeof admins !=='undefined' && admins && admins.length> 0) { %>
                                    <% for (let adm of admins) { %>
                                        <% if (adm && adm.email && adm.email.toLowerCase() !==mEmail) { %>
                                            <tr>
                                                <td class="ps-4 py-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                                                            style="width: 40px; height: 40px; background: #4a5568; font-weight: bold;">
                                                            <%= (adm.name && adm.name.length> 0) ?
                                                                adm.name.charAt(0).toUpperCase() : 'A' %>
                                                        </div>
                                                        <div>
                                                            <strong class="d-block text-dark">
                                                                <%= adm.name %>
                                                            </strong>
                                                            <span class="text-muted small" style="font-size: 0.75rem;">
                                                                Workshop Staff / Sub-Admin
                                                                <% if (adm.phone) { %> • 📞 <%= adm.phone %>
                                                                        <% } %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted">
                                                        <%= adm.email %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border px-2 py-1">
                                                        Operations &amp; Catalog Only
                                                    </span>
                                                </td>
                                                <td class="small text-muted">
                                                    <%= adm.createdAt ? new
                                                        Date(adm.createdAt).toLocaleDateString('en-IN') : 'Recently' %>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <% if (isCurrentUserMaster) { %>
                                                        <form action="/admin/admins/<%= adm._id %>/delete" method="POST"
                                                            onsubmit="return confirm('Revoke admin access for <%= adm.name %>? They will no longer be able to log in.');"
                                                            class="d-inline">
                                                            <button type="submit"
                                                                class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                                <i class="bi bi-trash3 me-1"></i> Revoke Access
                                                            </button>
                                                        </form>
                                                        <% } else { %>
                                                            <span class="text-muted small">—</span>
                                                            <% } %>
                                                </td>
                                            </tr>
                                            <% } %>
                                                <% } %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="5" class="text-center py-4 text-muted small">
                                                                <i class="bi bi-info-circle me-1"></i> No sub-admins
                                                                added yet. Click <strong>"Add New Sub-Admin"</strong>
                                                                above to grant access to staff.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </section>

        <!-- ─── MODAL: ADD NEW SUB-ADMIN (ONLY MASTER ADMIN CAN USE) ─── -->
        <div class="modal fade" id="addAdminModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-bottom py-3 px-4" style="background: #FAF7F2;">
                        <h5 class="modal-title font-serif fw-bold" style="color: #174840;">
                            <i class="bi bi-shield-plus me-2 text-warning"></i>Grant Operations Admin Access
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/admin/admins/add" method="POST">
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">STAFF FULL NAME *</label>
                                <input type="text" name="name" class="form-control rounded-3"
                                    placeholder="e.g. Workshop Supervisor" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">LOGIN EMAIL ADDRESS *</label>
                                <input type="email" name="email" class="form-control rounded-3"
                                    placeholder="e.g. supervisor@mnandsons.com" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">CONTACT / WHATSAPP NUMBER
                                    (OPTIONAL)</label>
                                <input type="text" name="phone" class="form-control rounded-3"
                                    placeholder="+91 9876543210">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">SET LOGIN PASSWORD *</label>
                                <input type="password" name="password" class="form-control rounded-3"
                                    placeholder="Create a strong password (min 6 characters)" required minlength="6">
                                <div class="form-text small text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Sub-admins can update fabrication stages, manage catalog products &amp; categories,
                                    but <strong>cannot delete or add other admins</strong>.
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top py-3 px-4" style="background: #FAF7F2;">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                                data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-manzar-primary px-4 rounded-pill">
                                <i class="bi bi-check-circle me-1"></i> Create Sub-Admin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>