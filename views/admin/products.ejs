<% layout('layouts/boilerplate') %>

    <% const activeCat=(typeof selectedCategory !=='undefined' && selectedCategory) ? selectedCategory : 'All' ; %>

        <section class="py-5" style="min-height: 85vh; background: #FAF7F2;">
            <div class="container-xl px-4">

                <!-- Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom"
                    style="border-color: #E8DCCF !important;">
                    <div>
                        <a href="/admin" class="text-decoration-none small text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Dashboard
                        </a>
                        <h1 class="font-serif fw-bold mt-1 mb-0" style="color: #174840;">Product Catalog Management</h1>
                        <small class="text-muted">Manage heavy-gauge almirahs, iron safes &amp; commercial
                            storage</small>
                    </div>
                    <div class="mt-3 mt-md-0">
                        <button class="btn btn-manzar-primary btn-sm px-4 rounded-pill" data-bs-toggle="modal"
                            data-bs-target="#addProductModal">
                            <i class="bi bi-plus-circle-fill me-1"></i> Add New Product
                        </button>
                    </div>
                </div>

                <!-- Category Filter Pills -->
                <div class="d-flex gap-2 overflow-auto pb-3 mb-3">
                    <a href="/admin/products"
                        class="btn btn-sm <%= activeCat === 'All' ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 text-nowrap">
                        All (<%= typeof products !=='undefined' && products ? products.length : 0 %>)
                    </a>
                    <% if (typeof categories !=='undefined' && categories && categories.length> 0) { %>
                        <% for (let cat of categories) { %>
                            <a href="/admin/products?category=<%= encodeURIComponent(cat.name) %>"
                                class="btn btn-sm <%= activeCat === cat.name ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 text-nowrap">
                                <%= cat.icon || '🗄️' %>
                                    <%= cat.name %>
                            </a>
                            <% } %>
                                <% } %>
                </div>

                <!-- Products Table Card -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white"
                    style="border: 1px solid #E8DCCF !important;">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-muted text-uppercase" style="letter-spacing: 0.05em;">
                                <tr>
                                    <th class="ps-4 py-3">Product</th>
                                    <th class="py-3">Category</th>
                                    <th class="py-3">Price</th>
                                    <th class="py-3">Gauge &amp; Weight</th>
                                    <th class="py-3">Lock Type</th>
                                    <th class="text-end pe-4 py-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof products !=='undefined' && products && products.length> 0) { %>
                                    <% for (let p of products) { %>
                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="<%= p.image || 'https://images.unsplash.com/photo-1595428774223-ef52624120d2?w=800&auto=format&fit=crop&q=80' %>"
                                                        alt="<%= p.title %>"
                                                        class="rounded-3 shadow-sm object-fit-cover"
                                                        style="width: 52px; height: 52px; border: 1px solid #E8DCCF;">
                                                    <div>
                                                        <strong class="d-block text-dark" style="font-size: 0.95rem;">
                                                            <%= p.title %>
                                                        </strong>
                                                        <% if (p.isFeatured) { %>
                                                            <span class="badge bg-warning text-dark"
                                                                style="font-size: 0.65rem;">★ Featured (Hero)</span>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                    <%= p.category || 'General' %>
                                                </span>
                                            </td>
                                            <td>
                                                <strong style="color: #174840;">₹<%= (p.price ||
                                                        0).toLocaleString('en-IN') %></strong>
                                                <% if (p.discountPrice) { %>
                                                    <span
                                                        class="text-muted small text-decoration-line-through d-block">₹
                                                        <%= p.discountPrice.toLocaleString('en-IN') %></span>
                                                    <% } %>
                                            </td>
                                            <td class="small text-muted">
                                                <div>
                                                    <%= p.sheetThickness || '18 Gauge' %>
                                                </div>
                                                <div>⚖️ <%= p.weightKg || 95 %> kg</div>
                                            </td>
                                            <td>
                                                <span class="small text-muted">
                                                    <%= p.lockType || 'Standard Lock' %>
                                                </span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="d-inline-flex gap-2">
                                                    <button class="btn btn-sm btn-outline-dark rounded-pill px-3"
                                                        data-bs-toggle="modal" data-bs-target="#editModal<%= p._id %>">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </button>

                                                    <form action="/admin/products/delete/<%= p._id %>" method="POST"
                                                        onsubmit="return confirm('Permanently delete <%= p.title %>?');"
                                                        class="d-inline">
                                                        <button type="submit"
                                                            class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                            <i class="bi bi-trash3 me-1"></i> Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- ─── MODAL: EDIT PRODUCT ─── -->
                                        <div class="modal fade" id="editModal<%= p._id %>" tabindex="-1"
                                            aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom py-3 px-4"
                                                        style="background: #FAF7F2;">
                                                        <h5 class="modal-title font-serif fw-bold"
                                                            style="color: #174840;">
                                                            Edit Product: <%= p.title %>
                                                        </h5>
                                                        <button type="button" class="btn-close"
                                                            data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form action="/admin/products/edit/<%= p._id %>" method="POST"
                                                        enctype="multipart/form-data">
                                                        <div class="modal-body p-4">
                                                            <div class="row g-3">
                                                                <div class="col-md-8">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">PRODUCT
                                                                        TITLE *</label>
                                                                    <input type="text" name="title"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.title %>" required>
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">CATEGORY
                                                                        *</label>
                                                                    <select name="category"
                                                                        class="form-select rounded-3">
                                                                        <% if (typeof categories !=='undefined' &&
                                                                            categories) { %>
                                                                            <% for (let cat of categories) { %>
                                                                                <option value="<%= cat.name %>"
                                                                                    <%=p.category===cat.name
                                                                                    ? 'selected' : '' %>>
                                                                                    <%= cat.name %>
                                                                                </option>
                                                                                <% } %>
                                                                                    <% } else { %>
                                                                                        <option
                                                                                            value="<%= p.category %>">
                                                                                            <%= p.category %>
                                                                                        </option>
                                                                                        <% } %>
                                                                    </select>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">SELLING
                                                                        PRICE (₹) *</label>
                                                                    <input type="number" name="price"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.price %>" required>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">MRP
                                                                        / ORIGINAL PRICE (₹)</label>
                                                                    <input type="number" name="discountPrice"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.discountPrice || '' %>">
                                                                </div>

                                                                <div class="col-md-4">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">SHEET
                                                                        GAUGE</label>
                                                                    <input type="text" name="sheetThickness"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.sheetThickness || '18 Gauge (1.2mm)' %>">
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">APPROX
                                                                        WEIGHT (KG)</label>
                                                                    <input type="number" name="weightKg"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.weightKg || 95 %>">
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">LOCK
                                                                        TYPE</label>
                                                                    <input type="text" name="lockType"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.lockType || 'Ultra-Secure Lever Lock' %>">
                                                                </div>

                                                                <!-- PHOTO SECTION IN EDIT -->
                                                                <div class="col-12">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted d-block">CURRENT
                                                                        PHOTO</label>
                                                                    <div class="d-flex align-items-center gap-3 mb-2">
                                                                        <img src="<%= p.image %>" alt="<%= p.title %>"
                                                                            class="rounded-3 shadow-sm"
                                                                            style="width: 60px; height: 60px; object-fit: cover;">
                                                                        <span class="small text-muted">Choose a new
                                                                            photo below if you want to replace
                                                                            this.</span>
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">UPLOAD
                                                                        NEW PHOTO (GALLERY / 📷 CAMERA)</label>
                                                                    <input type="file" name="productImage"
                                                                        class="form-control rounded-3" accept="image/*">
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">OR
                                                                        KEEP / EDIT IMAGE URL</label>
                                                                    <input type="text" name="image"
                                                                        class="form-control rounded-3"
                                                                        value="<%= p.image %>">
                                                                </div>

                                                                <div class="col-12">
                                                                    <label
                                                                        class="form-label small fw-bold text-muted">PRODUCT
                                                                        DESCRIPTION</label>
                                                                    <textarea name="description" rows="3"
                                                                        class="form-control rounded-3"><%= p.description || '' %></textarea>
                                                                </div>

                                                                <div class="col-12">
                                                                    <div class="form-check form-switch mt-2">
                                                                        <input class="form-check-input" type="checkbox"
                                                                            name="isFeatured" id="feat<%= p._id %>"
                                                                            <%=p.isFeatured ? 'checked' : '' %>>
                                                                        <label
                                                                            class="form-check-label small fw-bold text-dark"
                                                                            for="feat<%= p._id %>">
                                                                            Feature on Homepage Hero Section
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-top py-3 px-4"
                                                            style="background: #FAF7F2;">
                                                            <button type="button"
                                                                class="btn btn-outline-secondary rounded-pill px-4"
                                                                data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit"
                                                                class="btn btn-manzar-primary px-4 rounded-pill">Save
                                                                Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-5 text-muted">
                                                        <i class="bi bi-box fs-2 d-block mb-2 text-muted"></i>
                                                        No products found in this category. Click <strong>"Add New
                                                            Product"</strong> to list one!
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </section>

        <!-- ─── MODAL: ADD NEW PRODUCT (WITH GALLERY / CAMERA UPLOAD) ─── -->
        <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-bottom py-3 px-4" style="background: #FAF7F2;">
                        <h5 class="modal-title font-serif fw-bold" style="color: #174840;">
                            <i class="bi bi-plus-circle me-2 text-warning"></i>Add New Almirah / Safe
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/products/add" method="POST" enctype="multipart/form-data">
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label small fw-bold text-muted">PRODUCT TITLE *</label>
                                    <input type="text" name="title" class="form-control rounded-3"
                                        placeholder="e.g. Royal 3-Door Heavy Gauge Almirah" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">CATEGORY *</label>
                                    <select name="category" class="form-select rounded-3">
                                        <% if (typeof categories !=='undefined' && categories && categories.length> 0) {
                                            %>
                                            <% for (let cat of categories) { %>
                                                <option value="<%= cat.name %>">
                                                    <%= cat.name %>
                                                </option>
                                                <% } %>
                                                    <% } else { %>
                                                        <option value="General">General</option>
                                                        <option value="Bedroom">Bedroom</option>
                                                        <option value="Office">Office</option>
                                                        <% } %>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">SELLING PRICE (₹) *</label>
                                    <input type="number" name="price" class="form-control rounded-3"
                                        placeholder="e.g. 18500" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">MRP / ORIGINAL PRICE (₹)</label>
                                    <input type="number" name="discountPrice" class="form-control rounded-3"
                                        placeholder="e.g. 21000">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">SHEET GAUGE</label>
                                    <input type="text" name="sheetThickness" class="form-control rounded-3"
                                        value="18 Gauge (1.2mm)">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">APPROX WEIGHT (KG)</label>
                                    <input type="number" name="weightKg" class="form-control rounded-3" value="95">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">LOCK TYPE</label>
                                    <input type="text" name="lockType" class="form-control rounded-3"
                                        value="Ultra-Secure Lever Lock">
                                </div>

                                <!-- 📸 DIRECT PHOTO UPLOAD BUTTON -->
                                <div class="col-md-7">
                                    <label class="form-label small fw-bold text-dark">
                                        <i class="bi bi-camera-fill text-success me-1"></i> PHOTO: CHOOSE FROM GALLERY /
                                        CAMERA 📷
                                    </label>
                                    <input type="file" name="productImage" class="form-control rounded-3 py-2"
                                        accept="image/*">
                                    <div class="form-text small text-muted">
                                        मोबाइल से सीधे फोटो खींचें या गैलरी से सेलेक्ट करें।
                                    </div>
                                </div>

                                <!-- OPTIONAL URL FALLBACK -->
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold text-muted">OR PASTE WEB IMAGE URL
                                        (OPTIONAL)</label>
                                    <input type="url" name="image" class="form-control rounded-3 py-2"
                                        placeholder="https://...">
                                    <div class="form-text small text-muted">
                                        अगर इंटरनेट से कोई फ़ोटो लिंक डालना चाहें।
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted">DESCRIPTION</label>
                                    <textarea name="description" rows="3" class="form-control rounded-3"
                                        placeholder="Handcrafted with precision CRCA heavy sheet, internal safety locker, powder coated finish..."></textarea>
                                </div>

                                <div class="col-12">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" name="isFeatured"
                                            id="isFeaturedNew">
                                        <label class="form-check-label small fw-bold text-dark" for="isFeaturedNew">
                                            Feature on Homepage Hero Section
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top py-3 px-4" style="background: #FAF7F2;">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                                data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-manzar-primary px-4 rounded-pill">
                                <i class="bi bi-cloud-upload-fill me-1"></i> Upload &amp; Add Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>