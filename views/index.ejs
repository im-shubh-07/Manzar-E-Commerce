<% layout('layouts/boilerplate') %>

  <!-- ════════════ HERO SECTION ════════════ -->
  <section id="top" class="hero-section">
    <div class="container-xl px-4 py-5 py-md-0 h-100">
      <div class="row align-items-center h-100 g-5">
        <div class="col-md-6">
          <p class="text-warning text-uppercase fw-semibold small mb-3" style="letter-spacing:.2em">
            <i class="bi bi-stars me-1"></i> Made for your everyday
          </p>
          <h1 class="font-serif display-4 lh-1 manzar-green mb-4">
            Storage that feels like <em class="text-warning fst-normal">home.</em>
          </h1>
          <p class="text-muted lead-sm mb-5">
            Thoughtfully crafted steel almirahs for rooms that deserve more than ordinary.
            Strong, spacious, and made in Purnia.
          </p>
          <div class="d-flex flex-wrap align-items-center gap-4">
            <a href="#shop" class="btn btn-warning rounded-pill px-5 py-3 fw-semibold text-white">
              Explore Collection <i class="bi bi-arrow-right ms-2"></i>
            </a>
            <span class="text-muted small text-uppercase" style="letter-spacing:.15em">Since 1998 · Bihar</span>
          </div>
        </div>

        <% if (typeof featuredProduct !=='undefined' && featuredProduct) { %>
          <div class="col-md-6">
            <div class="hero-img-wrap">
              <img
                src="<%= (featuredProduct.images && featuredProduct.images.length > 0) ? featuredProduct.images[0] : (featuredProduct.image || 'https://images.unsplash.com/photo-1595428774223-ef52624120d2?auto=format&fit=crop&w=800&q=80') %>"
                alt="<%= featuredProduct.name %> — M N & SONS" class="hero-img" />
              <div class="hero-badge">
                <p class="text-uppercase small text-muted mb-0" style="letter-spacing:.18em">Featured</p>
                <p class="font-serif fs-5 manzar-green mb-0">
                  <%= featuredProduct.name %>
                </p>
              </div>
            </div>
          </div>
          <% } %>
      </div>
    </div>
  </section>

  <!-- ════════════ SHOP SECTION ════════════ -->
  <section id="shop" class="py-5 py-md-6 shop-section">
    <div class="container-xl px-4">

      <!-- Section Header -->
      <div class="row align-items-end mb-5">
        <div class="col-md-6">
          <p class="text-warning text-uppercase fw-semibold small mb-2" style="letter-spacing:.2em">The Collection</p>
          <h2 class="font-serif display-5 manzar-green mb-0">Made to last.</h2>
        </div>
        <div class="col-md-6">
          <p class="text-muted mb-0">Clean lines, generous storage, and finishes that make space feel considered.</p>
        </div>
      </div>

      <!-- Filters Bar -->
      <form method="GET" action="/#shop" id="filterForm">
        <div
          class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-top border-bottom py-3 mb-5">

          <!-- 🌟 DYNAMIC CATEGORY TABS (FROM DATABASE) 🌟 -->
          <div class="d-flex flex-wrap gap-3 align-items-center">

            <!-- 'All' Tab -->
            <% const activeCat=(typeof currentCategory !=='undefined' ) ? currentCategory : ((typeof category
              !=='undefined' ) ? category : 'All' ); %>
              <button type="submit" name="category" value="All"
                class="btn btn-link p-0 text-decoration-none fw-semibold filter-tab <%= (activeCat === 'All') ? 'active-tab text-dark fw-bold' : 'text-muted' %>">
                All
              </button>

              <!-- Dynamic Categories Loop from MongoDB -->
              <% if (typeof categories !=='undefined' && categories.length> 0) { %>
                <% categories.forEach(cat=> { %>
                  <button type="submit" name="category" value="<%= cat.name %>"
                    class="btn btn-link p-0 text-decoration-none fw-semibold filter-tab <%= (activeCat === cat.name) ? 'active-tab text-dark fw-bold' : 'text-muted' %>">
                    <%= cat.name %>
                  </button>
                  <% }); %>
                    <% } else { %>
                      <!-- Fallback if database empty -->
                      <button type="submit" name="category" value="Bedroom"
                        class="btn btn-link p-0 text-decoration-none fw-semibold filter-tab text-muted">Bedroom</button>
                      <button type="submit" name="category" value="Office"
                        class="btn btn-link p-0 text-decoration-none fw-semibold filter-tab text-muted">Office</button>
                      <% } %>

                        <% if (typeof search !=='undefined' && search) { %>
                          <input type="hidden" name="search" value="<%= search %>" />
                          <% } %>
          </div>

          <!-- Sort Dropdown -->
          <div class="d-flex align-items-center gap-3">
            <select name="sort" class="form-select form-select-sm border-0 shadow-none text-muted" style="width:auto"
              onchange="this.form.submit()">
              <option value="featured" <%=(typeof sort !=='undefined' && sort==='featured' ) ? 'selected' : '' %>
                >Featured</option>
              <option value="price_asc" <%=(typeof sort !=='undefined' && sort==='price_asc' ) ? 'selected' : '' %>
                >Price: Low to High</option>
              <option value="price_desc" <%=(typeof sort !=='undefined' && sort==='price_desc' ) ? 'selected' : '' %>
                >Price: High to Low</option>
            </select>
          </div>
        </div>
      </form>

      <!-- Products Grid -->
      <% if (!products || products.length===0) { %>
        <div class="text-center border border-dashed rounded-4 py-5">
          <p class="font-serif fs-3 manzar-green">No almirahs found</p>
          <p class="text-muted">No products available in this category currently.</p>
          <a href="/#shop" class="btn btn-dark rounded-pill px-5 mt-2">View all pieces</a>
        </div>
        <% } else { %>
          <div class="row g-4">
            <% products.forEach(product=> { %>
              <% const prodImg=(product.images && product.images.length> 0) ? product.images[0] : (product.image ||
                'https://images.unsplash.com/photo-1595428774223-ef52624120d2?auto=format&fit=crop&w=800&q=80'); %>
                <div class="col-sm-6 col-lg-3">
                  <article class="product-card h-100 d-flex flex-column justify-content-between">
                    <div>
                      <div class="product-img-wrap">
                        <img src="<%= prodImg %>" alt="<%= product.name %>, <%= product.color %> almirah"
                          class="product-img" />
                        <a href="/products/<%= product._id %>" class="product-overlay-link"
                          aria-label="View <%= product.name %>">
                          <span class="overlay-btn btn btn-light btn-sm rounded-pill">Quick View</span>
                        </a>
                      </div>
                      <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                          <div>
                            <h3 class="font-serif fs-5 manzar-green mb-0">
                              <%= product.name %>
                            </h3>
                            <p class="text-muted small text-uppercase mb-1" style="letter-spacing:.1em">
                              <%= product.color %> &middot; <%= product.category %>
                            </p>
                            <div class="text-warning small">
                              <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                              <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                              <i class="bi bi-star-fill"></i>
                            </div>
                          </div>
                          <p class="fw-semibold small mt-1">₹<%= Number(product.price || 0).toLocaleString('en-IN') %>
                          </p>
                        </div>
                      </div>
                    </div>

                    <!-- ─── AJAX ADD TO CART FORM ─── -->
                    <div class="px-3 pb-3">
                      <form class="add-to-cart-form">
                        <input type="hidden" name="productId" value="<%= product._id %>">
                        <input type="hidden" name="title" value="<%= product.name %>">
                        <input type="hidden" name="price" value="<%= product.price %>">
                        <input type="hidden" name="image" value="<%= prodImg %>">

                        <button type="submit"
                          class="btn btn-outline-dark rounded-pill w-100 add-to-cart-btn fw-semibold">
                          + Add to Cart
                        </button>
                      </form>
                    </div>

                  </article>
                </div>
                <% }); %>
          </div>
          <% } %>
    </div>
  </section>

  <!-- ════════════ STORY SECTION ════════════ -->
  <section id="story" class="py-5 py-md-6 manzar-dark-bg text-white">
    <div class="container-xl px-4">
      <div class="row g-5 align-items-end">
        <div class="col-md-4">
          <p class="text-warning text-uppercase fw-semibold small mb-0" style="letter-spacing:.2em">Why M N &amp; SONS
          </p>
        </div>
        <div class="col-md-8">
          <h2 class="font-serif display-5 mb-4">Trust built here. Honesty delivered here.</h2>
          <p class="text-light opacity-75 lead-sm">
            From our workshop near Urdu Middle School, Abubakar Masjid Road, every piece is built with
            durable steel, careful finishing, and the belief that good furniture should stay with you for years.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ FOOTER ════════════ -->
  <footer id="contact" class="py-5 footer-section">
    <div class="container-xl px-4">
      <div class="row justify-content-between align-items-center g-4">
        <div class="col-md-4">
          <p class="font-serif fs-2 manzar-green mb-1">M N &amp; SONS<span class="text-warning">.</span></p>
          <p class="text-muted small mb-0">M N &amp; SONS · Purnia, Bihar</p>
        </div>
        <div class="col-md-4 text-md-end">
          <a href="tel:7782091388" class="d-block text-muted text-decoration-none mb-2">
            <i class="bi bi-telephone me-2"></i>7782091388
          </a>
          <a href="https://wa.me/919470023148" class="d-block text-muted text-decoration-none mb-2" target="_blank">
            <i class="bi bi-whatsapp me-2"></i>9470023148
          </a>
          <p class="text-muted small mb-0">@mn_and_sons</p>
        </div>
      </div>
      <hr class="mt-4 mb-3 border-light opacity-25" />
      <p class="text-center text-muted small mb-0">© <%= new Date().getFullYear() %> M N &amp; SONS. All rights
          reserved.</p>
    </div>
  </footer>

  <!-- ════════════ JAVASCRIPT: INSTANT ADD TO CART ════════════ -->
  <script>
    document.querySelectorAll('.add-to-cart-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const btn = form.querySelector('button');
        const originalText = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = 'Adding...';

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.ajax = true;

        try {
          const response = await fetch('/cart/add', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          // 🔒 1. Agar User Logged-in NAHI hai, toh Login page par bhejo
          if (!result.success && result.requireLogin) {
            window.location.href = '/login';
            return;
          }

          // ✅ 2. Agar User Logged-in hai aur product add ho gaya
          if (result.success) {
            const badge = document.getElementById('cart-badge-count');
            if (badge) {
              badge.innerText = result.cartCount;
              badge.style.transform = 'scale(1.3)';
              setTimeout(() => { badge.style.transform = 'scale(1)'; }, 200);
            }

            btn.classList.remove('btn-outline-dark');
            btn.classList.add('btn-success', 'text-white');
            btn.innerHTML = '✓ Added!';

            setTimeout(() => {
              btn.classList.remove('btn-success', 'text-white');
              btn.classList.add('btn-outline-dark');
              btn.innerHTML = originalText;
              btn.disabled = false;
            }, 2000);
          }
        } catch (err) {
          console.error('Error adding to cart:', err);
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      });
    });
  </script>