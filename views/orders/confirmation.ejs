<% layout('layouts/boilerplate') %>

    <section class="py-5 d-flex align-items-center" style="min-height: 80vh; background-color: var(--manzar-cream);">
        <div class="container-xl px-4 text-center">

            <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto"
                style="max-width: 600px; background: #FFFFFF; border: 1px solid var(--manzar-border) !important;">
                <div class="mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                        style="width: 80px; height: 80px; background: #D4EDDA; color: #155724; font-size: 2.5rem;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>

                <span class="text-uppercase small fw-bold text-muted" style="letter-spacing: 0.15em;">M N &amp; SONS
                    &middot; PURNIA</span>
                <h2 class="font-serif fw-bold mt-2" style="color: #174840;">Order Successfully Placed!</h2>
                <p class="text-muted mt-2">
                    Thank you for choosing M N &amp; SONS. Your steel almirah fabrication order has been recorded and
                    confirmed.
                </p>

                <% if (order) { %>
                    <div class="p-3 rounded-3 text-start mb-4" style="background: #FAF7F2; border: 1px solid #E8DCCF;">
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-muted">Order ID:</span>
                            <strong style="color: #174840;">#<%= order._id.toString().slice(-8).toUpperCase() %>
                                    </strong>
                        </div>
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-muted">Advance Paid:</span>
                            <strong class="text-success">₹<%= Number(order.advancePaid || 0).toLocaleString('en-IN') %>
                                    </strong>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Estimated Delivery:</span>
                            <strong class="text-dark">5–7 Working Days (Purnia &amp; nearby)</strong>
                        </div>
                    </div>
                    <% } %>

                        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                            <a href="/orders/<%= order._id %>/invoice" target="_blank" class="btn btn-dark rounded-pill px-4 py-2">
                                <i class="bi bi-printer me-1"></i> Print Order Receipt
                            </a>
                            <a href="/orders/my-orders" class="btn btn-manzar-primary px-4 py-2">
                                <i class="bi bi-truck me-1"></i> Track My Order
                            </a>
                            <a href="/" class="btn btn-outline-dark rounded-pill px-4 py-2">
                                Back to Home
                            </a>
                        </div>

            </div>

        </div>
    </section>