<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #F4EFEB;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1a1a1a;
            padding: 30px 15px;
        }
        .invoice-card {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 40px;
            border: 1px solid #E5DCD3;
        }
        .brand-title {
            color: #174840;
            font-family: Georgia, serif;
            font-weight: 700;
            font-size: 1.8rem;
            letter-spacing: -0.5px;
        }
        .invoice-badge {
            background: #FAF7F2;
            border: 1px solid #E8DCCF;
            border-radius: 8px;
            padding: 12px 16px;
        }
        .table th {
            background-color: #FAF7F2 !important;
            color: #555;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 2px solid #E8DCCF;
        }
        .due-box {
            background: #FFF5F5;
            border: 1px dashed #E53E3E;
            border-radius: 8px;
            padding: 12px 18px;
        }
        @media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .invoice-card {
                box-shadow: none;
                border: none;
                padding: 20px;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="invoice-card">

        <!-- Top Actions Bar (Hidden in Print) -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom no-print">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-dark btn-sm rounded-pill px-4">
                    <i class="bi bi-printer me-1"></i> Print / Save as PDF
                </button>
            </div>
        </div>

        <!-- Header -->
        <div class="row align-items-start pb-4 border-bottom mb-4">
            <div class="col-sm-7">
                <h1 class="brand-title mb-1">M N &amp; SONS</h1>
                <p class="text-muted small mb-1 fw-semibold">Heavy-Gauge Steel Almirahs &amp; Industrial Storage</p>
                <div class="small text-muted" style="line-height: 1.4;">
                    Workshop: Near Urdu Middle School, Abubakar Masjid Road,<br>
                    Purnia, Bihar — 854301<br>
                    <i class="bi bi-telephone me-1"></i> +91 7782091388 &middot; +91 98765 43210<br>
                    <i class="bi bi-envelope me-1"></i> info@mnandsons.com
                </div>
            </div>
            <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                <div class="invoice-badge text-start d-inline-block">
                    <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.1em;">OFFICIAL ORDER SLIP</div>
                    <div class="fw-bold fs-6" style="color: #174840;">
                        #<%= order._id.toString().slice(-8).toUpperCase() %>
                    </div>
                    <div class="small text-muted">
                        Date: <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </div>
                    <div class="mt-1">
                        <span class="badge <%= (order.paymentStatus === 'Advance Paid' || order.paymentStatus === 'Fully Paid') ? 'bg-success' : 'bg-warning text-dark' %>" style="font-size: 0.7rem;">
                            <%= order.paymentStatus || 'Pending' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer & Order Meta -->
        <div class="row mb-4">
            <div class="col-6">
                <div class="small text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.08em;">CUSTOMER DETAILS</div>
                <div class="fw-bold text-dark"><%= order.customerName || 'Valued Customer' %></div>
                <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= order.phone || 'Contact provided on file' %></div>
                <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i><%= order.deliveryAddress || 'Local Fabrication Delivery, Purnia' %></div>
            </div>
            <div class="col-6 text-end">
                <div class="small text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.08em;">FABRICATION STAGE</div>
                <div class="fw-bold fs-6" style="color: #B96F3D;">
                    <%= order.orderStatus || 'Confirmed' %>
                </div>
                <div class="small text-muted">
                    Est. Timeline: 5–7 Working Days
                </div>
                <% if (order.designRequirements) { %>
                    <div class="small text-muted mt-1 font-monospace" style="font-size: 0.75rem;">
                        <%= order.designRequirements %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Almirah / Product Description</th>
                        <th class="text-center" style="width: 80px;">Qty</th>
                        <th class="text-end" style="width: 120px;">Rate (₹)</th>
                        <th class="text-end" style="width: 130px;">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (order.items && order.items.length > 0) { %>
                        <% order.items.forEach((item, idx) => { %>
                            <tr>
                                <td class="text-center text-muted small"><%= idx + 1 %></td>
                                <td>
                                    <strong><%= (item.product && item.product.title) ? item.product.title : (item.title || 'Steel Almirah') %></strong>
                                    <% if (item.product && item.product.sheetThickness) { %>
                                        <div class="small text-muted"><%= item.product.sheetThickness %> &middot; <%= item.product.lockType || 'Standard Lock' %></div>
                                    <% } %>
                                </td>
                                <td class="text-center"><%= item.quantity || 1 %></td>
                                <td class="text-end">₹<%= Number(item.price || 0).toLocaleString('en-IN') %></td>
                                <td class="text-end fw-semibold">₹<%= (Number(item.price || 0) * Number(item.quantity || 1)).toLocaleString('en-IN') %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td class="text-center text-muted small">1</td>
                            <td>
                                <strong><%= order.title || 'Custom Steel Almirah Fabrication' %></strong>
                                <div class="small text-muted"><%= order.size || 'Standard Size' %> &middot; Handcrafted Heavy CRCA Sheet</div>
                            </td>
                            <td class="text-center">1</td>
                            <td class="text-end">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></td>
                            <td class="text-end fw-semibold">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Financial Summary -->
        <div class="row justify-content-end mb-4">
            <div class="col-sm-6">
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted">Total Order Value:</span>
                    <strong class="text-dark">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></strong>
                </div>
                <div class="d-flex justify-content-between py-1 small text-success">
                    <span>Advance Received:</span>
                    <strong>(-) ₹<%= Number(order.advancePaid || 0).toLocaleString('en-IN') %></strong>
                </div>
                <hr class="my-2">
                <div class="due-box d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-danger fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">BALANCE PAYABLE UPON DELIVERY</div>
                        <small class="text-muted" style="font-size: 0.75rem;">Pay via UPI / Cash upon receiving goods</small>
                    </div>
                    <div class="fs-5 fw-bold text-danger">
                        ₹<%= Number(order.remainingAmount !== undefined ? order.remainingAmount : (order.totalAmount - order.advancePaid)).toLocaleString('en-IN') %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terms & Signature Footer -->
        <div class="pt-4 border-top">
            <div class="row align-items-end text-muted small">
                <div class="col-8">
                    <strong class="d-block text-dark mb-1">Terms &amp; Fabrication Conditions:</strong>
                    <ul class="ps-3 mb-0" style="font-size: 0.75rem; line-height: 1.5;">
                        <li>Fabricated with precision high-grade CRCA steel sheet with anti-corrosive powder coating.</li>
                        <li>Safe delivery guaranteed within Purnia &amp; surrounding districts.</li>
                        <li>Remaining due balance is payable at the time of delivery or dispatch confirmation.</li>
                    </ul>
                </div>
                <div class="col-4 text-end">
                    <div class="pt-4" style="border-top: 1px solid #999;">
                        <strong class="d-block text-dark" style="font-size: 0.8rem;">M N &amp; SONS</strong>
                        <span style="font-size: 0.7rem;">Authorized Workshop Signatory</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
