<% layout('layouts/boilerplate') %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <div class="container-xl px-4 py-5" style="min-height: 85vh; background: #FAF7F2;">

        <!-- Top Navigation -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom"
            style="border-color: #E8DCCF !important;">
            <div>
                <span class="text-uppercase small fw-bold text-muted" style="letter-spacing: 0.15em;">M N &amp; SONS
                    ADMIN</span>
                <h2 class="font-serif fw-bold mb-0" style="color: #174840;">Workshop Orders &amp; Custom Requests</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <!-- ⚙️ Button to Customize Stage 2 & 3 Names -->
                <button class="btn btn-outline-dark btn-sm rounded-pill px-3" data-bs-toggle="modal"
                    data-bs-target="#editStagesModal">
                    <i class="bi bi-sliders me-1"></i> Customize Stages (2 &amp; 3)
                </button>
                <a href="/admin" class="btn btn-outline-dark btn-sm rounded-pill px-3"><i
                        class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                <a href="/admin/categories" class="btn btn-outline-dark btn-sm rounded-pill px-3"><i
                        class="bi bi-tags me-1"></i> Categories</a>
                <a href="/admin/products" class="btn btn-outline-dark btn-sm rounded-pill px-3"><i
                        class="bi bi-box me-1"></i> Catalog</a>
                <a href="/admin/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i
                        class="bi bi-box-arrow-right me-1"></i> Logout</a>
            </div>
        </div>

        <!-- ─── SECTION 1: CUSTOM ENQUIRIES (EXACT SAME AS ACTIVE ORDERS) ─── -->
        <% if (typeof enquiries !=='undefined' && enquiries.length> 0) { %>
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white"
                style="border: 1px solid #E8DCCF !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="font-serif fw-semibold mb-0" style="color: #174840;">
                        <i class="bi bi-telephone-inbound-fill text-warning me-2"></i>Incoming Custom Requests (Pending
                        Calls)
                    </h4>
                    <span class="badge bg-light text-dark border px-3 py-2">
                        <%= enquiries.length %> Requests
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="text-muted small">
                            <tr>
                                <th>CUSTOMER</th>
                                <th style="min-width: 240px;">PRODUCT REQUESTED</th>
                                <th>COLOR &amp; SIZE</th>
                                <th>DESIGN NOTES</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% enquiries.forEach(enq=> { %>
                                <% const enqImg=enq.productImage
                                    || 'https://images.unsplash.com/photo-1595428774223-ef52624120d2?auto=format&fit=crop&w=300&q=80'
                                    ; const enqName=enq.productName || (enq.color ? enq.color + ' Custom Almirah'
                                    : 'Handcrafted Steel Almirah' ); %>
                                    <tr>
                                        <!-- 1. Customer & Phone -->
                                        <td>
                                            <strong>
                                                <%= enq.customerName || 'Valued Customer' %>
                                            </strong>
                                            <div class="mt-1">
                                                <a href="tel:<%= enq.phone %>"
                                                    class="btn btn-sm btn-outline-success rounded-pill px-3 py-0 fw-semibold"
                                                    style="font-size: 0.8rem;">
                                                    📞 <%= enq.phone %>
                                                </a>
                                            </div>
                                        </td>

                                        <!-- 2. 👉 PRODUCT REQUESTED (EXACT SAME THUMBNAIL + TITLE AS ORDERS) 👈 -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="<%= enqImg %>" alt="<%= enqName %>"
                                                    class="rounded-2 shadow-sm border"
                                                    style="width: 40px; height: 40px; object-fit: cover;">
                                                <div>
                                                    <strong class="d-block small text-dark"
                                                        style="color: #174840; font-size: 0.88rem;">
                                                        <%= enqName %>
                                                    </strong>
                                                    <span class="text-muted" style="font-size: 0.72rem;">Custom
                                                        fabrication request</span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- 3. Color & Size -->
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                <%= enq.color || 'Standard' %> &middot; <%= enq.size || 'Standard Size'
                                                        %>
                                            </span>
                                        </td>

                                        <!-- 4. Design Notes -->
                                        <td class="small text-muted" style="max-width: 220px;">
                                            <%= enq.designRequirements || '—' %>
                                        </td>

                                        <!-- 5. Action Button -->
                                        <td>
                                            <% if (enq.status==='Converted to Order' ) { %>
                                                <span
                                                    class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                    ✓ Order Confirmed
                                                </span>
                                                <% } else { %>
                                                    <button
                                                        class="btn btn-sm btn-warning rounded-pill px-3 text-white fw-semibold shadow-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#confirmModal<%= enq._id %>">
                                                        + Confirm Order
                                                    </button>

                                                    <!-- Confirm Order Modal -->
                                                    <div class="modal fade" id="confirmModal<%= enq._id %>"
                                                        tabindex="-1">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content rounded-4 border-0 shadow">
                                                                <div class="modal-header border-bottom py-3 px-4"
                                                                    style="background: #FAF7F2;">
                                                                    <h5 class="modal-title font-serif fw-bold"
                                                                        style="color: #174840;">
                                                                        Confirm Order for <%= enq.customerName %>
                                                                    </h5>
                                                                    <button type="button" class="btn-close"
                                                                        data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <form action="/admin/confirm-order" method="POST">
                                                                    <input type="hidden" name="enquiryId"
                                                                        value="<%= enq._id %>">
                                                                    <input type="hidden" name="customerName"
                                                                        value="<%= enq.customerName %>">
                                                                    <input type="hidden" name="phone"
                                                                        value="<%= enq.phone %>">
                                                                    <input type="hidden" name="title"
                                                                        value="<%= enqName %>">
                                                                    <input type="hidden" name="color"
                                                                        value="<%= enq.color %>">
                                                                    <input type="hidden" name="size"
                                                                        value="<%= enq.size %>">
                                                                    <input type="hidden" name="designRequirements"
                                                                        value="<%= enq.designRequirements %>">

                                                                    <div class="modal-body p-4">
                                                                        <!-- Preview Item -->
                                                                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-3"
                                                                            style="background: #FAF7F2; border: 1px solid #E8DCCF;">
                                                                            <img src="<%= enqImg %>" class="rounded-2"
                                                                                style="width: 45px; height: 45px; object-fit: cover;">
                                                                            <div>
                                                                                <strong style="color: #174840;">
                                                                                    <%= enqName %>
                                                                                </strong>
                                                                                <div class="small text-muted">
                                                                                    <%= enq.color %> &middot; <%=
                                                                                            enq.size %>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="mb-3">
                                                                            <label
                                                                                class="small fw-semibold text-muted">Final
                                                                                Agreed Price After Call (₹)</label>
                                                                            <input type="number" name="totalAmount"
                                                                                class="form-control rounded-3"
                                                                                placeholder="e.g. 21000" required>
                                                                        </div>

                                                                        <div class="mb-3">
                                                                            <label
                                                                                class="small fw-semibold text-muted">Advance
                                                                                Token Received (₹)</label>
                                                                            <input type="number" name="advancePaid"
                                                                                class="form-control rounded-3"
                                                                                placeholder="e.g. 5000" value="0">
                                                                        </div>

                                                                        <div class="mb-3">
                                                                            <label
                                                                                class="small fw-semibold text-muted">Delivery
                                                                                Address</label>
                                                                            <input type="text" name="deliveryAddress"
                                                                                class="form-control rounded-3"
                                                                                placeholder="e.g. Line Bazar, Purnia"
                                                                                required>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer border-top py-3 px-4"
                                                                        style="background: #FAF7F2;">
                                                                        <button type="button"
                                                                            class="btn btn-outline-secondary rounded-pill px-4"
                                                                            data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit"
                                                                            class="btn btn-warning rounded-pill px-4 text-white fw-semibold">
                                                                            Create Confirmed Order &rarr;
                                                                        </button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %> <!-- ─── SECTION 1.5: B2B COMMERCIAL & FRANCHISE LEADS ─── -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white"
                    style="border: 1px solid #E8DCCF !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="font-serif fw-semibold mb-0" style="color: #174840;">
                                <i class="bi bi-briefcase-fill text-warning me-2"></i>B2B Wholesale &amp; Franchise
                                Dealership Applications
                            </h4>
                            <small class="text-muted">Direct commercial partner requests from website sidebar</small>
                        </div>
                        <span class="badge bg-light text-dark border px-3 py-2">
                            <%= (typeof businessLeads !=='undefined' ) ? businessLeads.length : 0 %> Applications
                        </span>
                    </div>

                    <% if (!businessLeads || businessLeads.length===0) { %>
                        <p class="text-muted small mb-0 py-3 text-center">No wholesale or dealership applications yet.
                        </p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="text-muted small table-light">
                                        <tr>
                                            <th>TYPE</th>
                                            <th>APPLICANT &amp; ENTITY</th>
                                            <th>CITY / DISTRICT</th>
                                            <th>SCALE / CAPACITY</th>
                                            <th>REQUIREMENTS / MESSAGE</th>
                                            <th>ACTION &amp; STATUS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% businessLeads.forEach(lead=> { %>
                                            <tr>
                                                <!-- 1. Type Badge -->
                                                <td>
                                                    <% if (lead.type==='Bulk Wholesale' ) { %>
                                                        <span class="badge bg-warning text-dark border px-2 py-1">
                                                            <i class="bi bi-box-seam me-1"></i>Bulk Wholesale
                                                        </span>
                                                        <% } else { %>
                                                            <span
                                                                class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                                <i class="bi bi-people-fill me-1"></i>Franchise Partner
                                                            </span>
                                                            <% } %>
                                                </td>

                                                <!-- 2. Applicant & Organization -->
                                                <td>
                                                    <strong class="d-block" style="color: #174840;">
                                                        <%= lead.name %>
                                                    </strong>
                                                    <% if (lead.organization) { %>
                                                        <span class="badge bg-light text-dark border"
                                                            style="font-size: 0.75rem;">
                                                            🏢 <%= lead.organization %>
                                                        </span>
                                                        <% } %>
                                                </td>

                                                <!-- 3. City / District -->
                                                <td>
                                                    <span class="small fw-semibold text-dark"><i
                                                            class="bi bi-geo-alt"></i>
                                                        <%= lead.city || 'Bihar' %>
                                                    </span>
                                                </td>

                                                <!-- 4. Scale / Investment -->
                                                <td>
                                                    <strong class="text-dark small">
                                                        <%= lead.quantityOrInvestment || 'Standard Tier' %>
                                                    </strong>
                                                </td>

                                                <!-- 5. Message -->
                                                <td class="small text-muted" style="max-width: 200px;">
                                                    <%= lead.message || '—' %>
                                                </td>

                                                <!-- 6. Connect Buttons & Status Dropdown -->
                                                <td>
                                                    <div class="d-flex flex-column gap-2" style="min-width: 170px;">
                                                        <div class="d-flex gap-2">
                                                            <!-- Call Button -->
                                                            <a href="tel:<%= lead.phone %>"
                                                                class="btn btn-sm btn-outline-success rounded-pill px-2 py-0 fw-semibold"
                                                                style="font-size: 0.78rem;">
                                                                📞 <%= lead.phone %>
                                                            </a>
                                                            <!-- WhatsApp Button -->
                                                            <a href="https://wa.me/91<%= lead.phone.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(lead.name) %>,%20thank%20you%20for%20your%20interest%20in%20M%20N%20%26%20SONS%20<%= encodeURIComponent(lead.type) %>."
                                                                target="_blank"
                                                                class="btn btn-sm btn-success rounded-circle d-flex align-items-center justify-content-center"
                                                                style="width: 26px; height: 26px; padding: 0;">
                                                                <i class="bi bi-whatsapp"
                                                                    style="font-size: 0.8rem;"></i>
                                                            </a>
                                                        </div>

                                                        <!-- Status Form -->
                                                        <form action="/admin/business-leads/<%= lead._id %>/status"
                                                            method="POST" class="d-flex gap-1 m-0">
                                                            <select name="status"
                                                                class="form-select form-select-sm py-0 rounded-pill"
                                                                style="font-size: 0.75rem;"
                                                                onchange="this.form.submit()">
                                                                <option value="Pending" <%=lead.status==='Pending'
                                                                    ? 'selected' : '' %>>⏳ Pending</option>
                                                                <option value="Contacted" <%=lead.status==='Contacted'
                                                                    ? 'selected' : '' %>>📞 Contacted</option>
                                                                <option value="Closed" <%=lead.status==='Closed'
                                                                    ? 'selected' : '' %>>✓ Deal Closed</option>
                                                            </select>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                </div>
                <!-- ─── SECTION 2: LIVE ORDERS (CLEAN DROPDOWN WITHOUT CUSTOM NOTE BOX) ─── -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white"
                    style="border: 1px solid #E8DCCF !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="font-serif fw-semibold mb-0" style="color: #174840;">
                            <i class="bi bi-hammer text-success me-2"></i>Active Orders &amp; Production Status
                        </h4>
                        <span class="badge bg-warning text-dark px-3 py-2">
                            <%= orders.length %> Active
                        </span>
                    </div>

                    <% if (!orders || orders.length===0) { %>
                        <p class="text-muted small mb-0 py-3 text-center">No active orders yet.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="text-muted small">
                                        <tr>
                                            <th>ORDER ID</th>
                                            <th>CUSTOMER</th>
                                            <th>PRODUCT(S) ORDERED</th>
                                            <th>PAYMENT STATUS</th>
                                            <th>CURRENT STAGE</th>
                                            <th style="min-width: 250px;">UPDATE STAGE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% orders.forEach(ord=> { %>
                                            <% const total=Number(ord.totalAmount || 0); const
                                                advance=Number(ord.advancePaid || 0); const
                                                remaining=(ord.remainingAmount !==undefined) ?
                                                Number(ord.remainingAmount) : (total - advance); const
                                                isFullyPaid=advance>= total || ord.paymentStatus === 'Fully Paid' ||
                                                ord.paymentStatus === 'Paid';
                                                %>
                                                <tr>
                                                    <!-- 1. Order ID -->
                                                    <td>
                                                        <code class="fw-bold fs-6"
                                                            style="color: #B96F3D;">#<%= ord._id.toString().slice(-6).toUpperCase() %></code>
                                                        <a href="/orders/<%= ord._id %>/invoice" target="_blank"
                                                            class="d-block small text-decoration-none text-muted mt-1"
                                                            style="font-size: 0.72rem;">
                                                            <i class="bi bi-printer me-1"></i>Print Slip
                                                        </a>
                                                    </td>

                                                    <!-- 2. Customer -->
                                                    <td>
                                                        <strong>
                                                            <%= ord.customerName %>
                                                        </strong>
                                                        <div class="small text-muted">
                                                            <%= ord.phone || 'No phone' %>
                                                        </div>
                                                        <div class="small text-muted" style="font-size: 0.75rem;"><i
                                                                class="bi bi-geo-alt"></i>
                                                            <%= ord.deliveryAddress || 'Purnia' %>
                                                        </div>
                                                    </td>

                                                    <!-- 3. Ordered Product Details -->
                                                    <td>
                                                        <% if (ord.items && ord.items.length> 0) { %>
                                                            <div class="d-flex flex-column gap-1">
                                                                <% ord.items.forEach(it=> { %>
                                                                    <div class="d-flex align-items-center gap-2">
                                                                        <% if (it.image) { %>
                                                                            <img src="<%= it.image %>"
                                                                                class="rounded-2 shadow-sm"
                                                                                style="width: 35px; height: 35px; object-fit: cover;">
                                                                            <% } %>
                                                                                <span
                                                                                    class="small fw-semibold text-dark">
                                                                                    x<%= it.quantity || 1 %>
                                                                                        <%= (it.product &&
                                                                                            it.product.name) ?
                                                                                            it.product.name : (it.title
                                                                                            || 'Almirah' ) %>
                                                                                </span>
                                                                    </div>
                                                                    <% }); %>
                                                            </div>
                                                            <% } else { %>
                                                                <span class="small fw-semibold text-dark">
                                                                    <%= ord.title || 'Handcrafted Steel Almirah' %> (<%=
                                                                            ord.size || 'Standard' %>)
                                                                </span>
                                                                <% } %>
                                                    </td>

                                                    <!-- 4. Payment Breakdown -->
                                                    <td>
                                                        <div class="fw-bold text-dark fs-6">₹<%=
                                                                total.toLocaleString('en-IN') %>
                                                        </div>
                                                        <% if (isFullyPaid) { %>
                                                            <span
                                                                class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 mt-1">
                                                                <i class="bi bi-check-circle-fill me-1"></i>✓ Full
                                                                Payment
                                                            </span>
                                                            <% } else { %>
                                                                <div class="small text-success mt-1">
                                                                    Adv: <strong>₹<%= advance.toLocaleString('en-IN') %>
                                                                    </strong>
                                                                </div>
                                                                <div class="small text-danger fw-semibold">
                                                                    Due: <strong>₹<%= remaining.toLocaleString('en-IN')
                                                                            %></strong>
                                                                </div>
                                                                <% } %>
                                                                    <% if
                                                                        (ord.paymentStatus==='UTR Verification Pending'
                                                                        ) { %>
                                                                        <div
                                                                            class="mt-2 p-1 rounded bg-light border border-warning">
                                                                            <span
                                                                                class="badge bg-warning text-dark d-block mb-1"
                                                                                style="font-size: 0.68rem;">
                                                                                <i
                                                                                    class="bi bi-exclamation-triangle-fill me-1"></i>UTR
                                                                                Verification Pending
                                                                            </span>
                                                                            <% if (ord.designRequirements) { %>
                                                                                <div class="text-dark small fw-semibold"
                                                                                    style="font-size: 0.72rem;">
                                                                                    <%= ord.designRequirements %>
                                                                                </div>
                                                                                <% } %>
                                                                                    <form
                                                                                        action="/admin/orders/<%= ord._id %>/update-payment"
                                                                                        method="POST" class="mt-1">
                                                                                        <input type="hidden"
                                                                                            name="paymentStatus"
                                                                                            value="Advance Paid">
                                                                                        <button type="submit"
                                                                                            class="btn btn-sm btn-success rounded-pill px-2 py-0 w-100"
                                                                                            style="font-size: 0.72rem;">
                                                                                            <i
                                                                                                class="bi bi-check2-circle me-1"></i>Confirm
                                                                                            Bank Receipt
                                                                                        </button>
                                                                                    </form>
                                                                        </div>
                                                                        <% } %>
                                                    </td>

                                                    <!-- 5. Current Stage Badge -->
                                                    <td>
                                                        <span
                                                            class="badge <%= ord.orderStatus === 'Delivered' ? 'bg-success' : 'bg-warning text-dark' %> px-3 py-2 fw-semibold">
                                                            <%= ord.orderStatus %>
                                                        </span>
                                                    </td>

                                                    <!-- 6. UPDATE STAGE: Clean Dropdown & Button (NO NOTE BOX) -->
                                                    <td>
                                                        <form action="/admin/update-status/<%= ord._id %>" method="POST"
                                                            class="d-flex align-items-center gap-2 m-0">
                                                            <select name="orderStatus"
                                                                class="form-select form-select-sm rounded-pill"
                                                                style="width: auto;">
                                                                <option value="Confirmed"
                                                                    <%=ord.orderStatus==='Confirmed' ? 'selected' : ''
                                                                    %>>
                                                                    1. Confirmed
                                                                </option>
                                                                <option value="<%= stage2Name %>"
                                                                    <%=(ord.orderStatus===stage2Name ||
                                                                    ord.orderStatus==='Under Fabrication' ||
                                                                    ord.orderStatus==='Fabrication' ) ? 'selected' : ''
                                                                    %>>
                                                                    2. <%= stage2Name %>
                                                                </option>
                                                                <option value="<%= stage3Name %>"
                                                                    <%=(ord.orderStatus===stage3Name ||
                                                                    ord.orderStatus==='Powder Coating' ) ? 'selected'
                                                                    : '' %>>
                                                                    3. <%= stage3Name %>
                                                                </option>
                                                                <option value="Dispatched"
                                                                    <%=ord.orderStatus==='Dispatched' ? 'selected' : ''
                                                                    %>>
                                                                    4. Dispatched
                                                                </option>
                                                                <option value="Delivered"
                                                                    <%=ord.orderStatus==='Delivered' ? 'selected' : ''
                                                                    %>>
                                                                    5. Delivered
                                                                </option>
                                                            </select>
                                                            <button type="submit"
                                                                class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold">
                                                                Update
                                                            </button>
                                                        </form>
                                                    </td>

                                                </tr>
                                                <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                </div>

    </div>

    <!-- ─── MODAL: CUSTOMIZE STAGE 2 & STAGE 3 NAMES ─── -->
    <div class="modal fade" id="editStagesModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom py-3 px-4" style="background: #FAF7F2;">
                    <h5 class="modal-title font-serif fw-bold" style="color: #174840;">
                        <i class="bi bi-sliders me-2"></i>Customize Production Stages (2 &amp; 3)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/orders/update-stage-names" method="POST">
                    <div class="modal-body p-4">
                        <p class="small text-muted mb-3">
                            Stage 1 (Confirmed), 4 (Dispatched) and 5 (Delivered) are standard. You can change Stage 2
                            and 3 names anytime according to your factory workflow:
                        </p>

                        <div class="mb-3">
                            <label class="small fw-bold text-muted">STAGE 2 NAME</label>
                            <input type="text" name="stage2Name" class="form-control rounded-3"
                                value="<%= typeof stage2Name !== 'undefined' ? stage2Name : 'Under Fabrication' %>"
                                placeholder="e.g. Raw Steel Cutting & Welding, or Fabrication" required>
                        </div>

                        <div class="mb-3">
                            <label class="small fw-bold text-muted">STAGE 3 NAME</label>
                            <input type="text" name="stage3Name" class="form-control rounded-3"
                                value="<%= typeof stage3Name !== 'undefined' ? stage3Name : 'Powder Coating' %>"
                                placeholder="e.g. Oven Powder Coating, or Lock Assembly" required>
                        </div>
                    </div>
                    <div class="modal-footer border-top py-3 px-4" style="background: #FAF7F2;">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                            data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-manzar-primary px-4">Save Stages</button>
                    </div>
                </form>
            </div>
        </div>
    </div>